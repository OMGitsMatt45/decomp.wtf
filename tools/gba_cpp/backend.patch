+    extern int lang_decode_option(int, char **);
+    lang_init_options();
     decl_printable_name = decl_name;
     lang_expand_expr = (lang_expand_expr_t) do_abort;
 
@@ -3646,6 +3649,8 @@ main(int argc, char **argv)
 
