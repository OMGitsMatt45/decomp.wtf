cmake_minimum_required(VERSION 3.24)
project(PS2NativePC LANGUAGES C CXX)
set(CMAKE_CXX_STANDARD 20)
set(CMAKE_CXX_STANDARD_REQUIRED ON)
if(NOT CMAKE_BUILD_TYPE AND NOT CMAKE_CONFIGURATION_TYPES)
  set(CMAKE_BUILD_TYPE Release CACHE STRING "Build type" FORCE)
endif()
if(NOT CMAKE_SYSTEM_PROCESSOR MATCHES "^(x86_64|AMD64|amd64|x64)$")
  message(FATAL_ERROR "This PS2 runtime integration currently requires an x86-64 host")
endif()
include("${CMAKE_CURRENT_SOURCE_DIR}/native/dependencies.cmake")
set(PS2X_BUILD_RECOMP OFF CACHE BOOL "" FORCE)
set(PS2X_BUILD_RUNTIME ON CACHE BOOL "" FORCE)
set(PS2X_BUILD_ANALYZER OFF CACHE BOOL "" FORCE)
set(PS2X_BUILD_TEST OFF CACHE BOOL "" FORCE)
set(PS2X_BUILD_STUDIO OFF CACHE BOOL "" FORCE)
set(PS2X_ENABLE_DEBUG_UI OFF CACHE BOOL "" FORCE)
set(PS2X_ENABLE_SCCACHE OFF CACHE BOOL "" FORCE)
set(PS2X_ENABLE_IOP_RPC_TRACE ON CACHE BOOL "" FORCE)
set(SDL_SHARED OFF CACHE BOOL "" FORCE)
set(SDL_STATIC ON CACHE BOOL "" FORCE)
set(SDL_TESTS OFF CACHE BOOL "" FORCE)
set(SDL_TEST_LIBRARY OFF CACHE BOOL "" FORCE)
find_package(SDL3 3.4 CONFIG QUIET)
if(NOT TARGET SDL3::SDL3)
  FetchContent_MakeAvailable(SDL3)
endif()
if(NOT MSVC)
  add_compile_options(-msse4.1 -fno-strict-aliasing -fwrapv)
else()
  add_compile_options(/utf-8)
endif()
set(PORT_ROOT "${CMAKE_CURRENT_SOURCE_DIR}/runtime/ps2")
add_subdirectory("${PORT_ROOT}/thirdparty/PS2Recomp" ps2-runtime EXCLUDE_FROM_ALL)
set_property(TARGET ps2_runtime PROPERTY INTERPROCEDURAL_OPTIMIZATION_RELEASE OFF)
add_subdirectory("${PORT_ROOT}/src/gfx" ps2-gs EXCLUDE_FROM_ALL)
if(NOT TARGET dq8_gfx_sdlgpu)
  message(FATAL_ERROR "The native output requires its SDL3 GPU renderer")
endif()
file(GLOB_RECURSE GAME_SOURCES CONFIGURE_DEPENDS "${CMAKE_CURRENT_SOURCE_DIR}/game/modules/*.cpp")
add_library(game_code STATIC ${GAME_SOURCES})
option(DECOMP_PS2_UNITY_BUILD "Batch generated functions to reduce compilation time" ON)
set_target_properties(game_code PROPERTIES UNITY_BUILD ${DECOMP_PS2_UNITY_BUILD} UNITY_BUILD_BATCH_SIZE 32)
target_include_directories(game_code PRIVATE
  "${PORT_ROOT}/thirdparty/PS2Recomp/ps2xRuntime/include"
  "${PORT_ROOT}/thirdparty/PS2Recomp/ps2xRuntime/include/runtime"
  "${PORT_ROOT}/thirdparty/PS2Recomp/ps2xRuntime/src/lib/vu"
  "${PORT_ROOT}/thirdparty/PS2Recomp/ps2xRuntime/src/lib/Kernel"
  "${PORT_ROOT}/thirdparty/PS2Recomp/ps2xIOP/include")
target_precompile_headers(game_code PRIVATE <ps2_runtime.h> <ps2_runtime_macros.h> <ps2_syscalls.h> <ps2_stubs.h>)
if(MSVC)
  target_compile_options(game_code PRIVATE /O1 /bigobj /fp:strict)
else()
  target_compile_options(game_code PRIVATE -O1 -g0 -ffp-contract=off)
endif()
add_executable(ps2_pc native/main.cpp native/modules.cpp)
target_include_directories(ps2_pc PRIVATE native)
if(CMAKE_CXX_LINK_GROUP_USING_RESCAN_SUPPORTED)
  target_link_libraries(ps2_pc PRIVATE "$<LINK_GROUP:RESCAN,game_code,ps2_runtime>" dq8_gfx_sdlgpu)
else()
  target_link_libraries(ps2_pc PRIVATE game_code ps2_runtime dq8_gfx_sdlgpu)
endif()
if(MSVC)
  target_link_options(ps2_pc PRIVATE /FORCE:MULTIPLE /STACK:8388608)
  target_sources(ps2_pc PRIVATE native/utf8.manifest)
endif()
ps2x_stage_ffmpeg_runtime_dlls(ps2_pc)
option(DECOMP_PS2_BUILD_SERVICE_TESTS "Build original filesystem/input/save service checks" OFF)
if(DECOMP_PS2_BUILD_SERVICE_TESTS)
  add_executable(ps2_service_probe tests/services.cpp native/modules.cpp)
  target_include_directories(ps2_service_probe PRIVATE native "${PORT_ROOT}/thirdparty/PS2Recomp/ps2xIOP/src/lle"
    "${PORT_ROOT}/thirdparty/PS2Recomp/ps2xRuntime/src/lib")
  if(CMAKE_CXX_LINK_GROUP_USING_RESCAN_SUPPORTED)
    target_link_libraries(ps2_service_probe PRIVATE "$<LINK_GROUP:RESCAN,game_code,ps2_runtime>")
  else()
    target_link_libraries(ps2_service_probe PRIVATE game_code ps2_runtime)
  endif()
  if(MSVC)
    target_link_options(ps2_service_probe PRIVATE /FORCE:MULTIPLE /STACK:8388608)
    target_sources(ps2_service_probe PRIVATE native/utf8.manifest)
  endif()
  ps2x_stage_ffmpeg_runtime_dlls(ps2_service_probe)
endif()
