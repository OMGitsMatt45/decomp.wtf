# Build-selected CPU policy. Reference builds preserve the original ISA engines.
option(DECOMP_PS2_REFERENCE "Build the separate instruction-reference player" OFF)
set(DECOMP_PS2_VU_OPTIMIZATION "2" CACHE STRING "Native vector operation optimization level (1 or 2)")
set_property(CACHE DECOMP_PS2_VU_OPTIMIZATION PROPERTY STRINGS 1 2)
if(NOT DECOMP_PS2_VU_OPTIMIZATION MATCHES "^[12]$")
  message(FATAL_ERROR "DECOMP_PS2_VU_OPTIMIZATION must be 1 or 2")
endif()
# clang-cl uses the MSVC frontend syntax too. Its driver ignores bare -O1/-O2.
if(MSVC)
  set(_decomp_ps2_vu_options "/O${DECOMP_PS2_VU_OPTIMIZATION}")
else()
  set(_decomp_ps2_vu_options "-O${DECOMP_PS2_VU_OPTIMIZATION}")
endif()
set(DECOMP_PS2_PLAYER ps2_pc)
if(DECOMP_PS2_REFERENCE)
  set(DECOMP_PS2_PLAYER ps2_probe)
else()
  get_target_property(_iop_sources ps2_iop SOURCES)
  list(FIND _iop_sources "src/lle/cpu.cpp" _iop_cpu_index)
  if(_iop_cpu_index LESS 0)
    message(FATAL_ERROR "Pinned IOP source layout differs")
  endif()
  list(REMOVE_ITEM _iop_sources "src/lle/cpu.cpp")
  set_property(TARGET ps2_iop PROPERTY SOURCES "${_iop_sources}")
  file(GLOB IOP_NATIVE_OPERATIONS CONFIGURE_DEPENDS "${CMAKE_CURRENT_SOURCE_DIR}/game/iop/*.cpp")
  target_sources(ps2_iop PRIVATE ${IOP_NATIVE_OPERATIONS} "${CMAKE_CURRENT_SOURCE_DIR}/native/iop/engine.cpp")
  target_include_directories(ps2_iop PRIVATE "${CMAKE_CURRENT_SOURCE_DIR}/native/iop"
    "${PORT_ROOT}/thirdparty/PS2Recomp/ps2xIOP/src/lle")
  file(GLOB VU_NATIVE_OPERATIONS CONFIGURE_DEPENDS "${CMAKE_CURRENT_SOURCE_DIR}/game/vu/*.cpp")
  file(GLOB VU_NATIVE_PROGRAMS CONFIGURE_DEPENDS "${CMAKE_CURRENT_SOURCE_DIR}/game/vu_programs/*.cpp")
  target_sources(ps2_runtime PRIVATE ${VU_NATIVE_OPERATIONS}
    ${VU_NATIVE_PROGRAMS}
    "${PORT_ROOT}/thirdparty/PS2Recomp/ps2xRuntime/src/lib/vu/decomp_vu_pipeline.cpp")
  target_compile_definitions(ps2_runtime PRIVATE DECOMP_PS2_NATIVE_VU=1)
  if(VU_NATIVE_PROGRAMS)
    target_compile_definitions(ps2_runtime PRIVATE DECOMP_PS2_NATIVE_VU_PROGRAMS=1)
  endif()
  target_include_directories(ps2_runtime PRIVATE "${PORT_ROOT}/thirdparty/PS2Recomp/ps2xRuntime/src/lib/vu")
  set_source_files_properties(${VU_NATIVE_OPERATIONS} ${VU_NATIVE_PROGRAMS} TARGET_DIRECTORY ps2_runtime
    PROPERTIES SKIP_UNITY_BUILD_INCLUSION ON COMPILE_OPTIONS "${_decomp_ps2_vu_options}")
endif()

option(DECOMP_PS2_BUILD_NATIVE_TESTS "Build original native IOP/vector execution probes" OFF)
if(DECOMP_PS2_BUILD_NATIVE_TESTS)
  set(PS2_TEST_ROOT "${PORT_ROOT}/thirdparty/PS2Recomp/ps2xTest")
  add_executable(ps2_vu_probe tests/native_vu_probe.cpp "${PS2_TEST_ROOT}/src/test_function_table.cpp")
  # Probe operations must preserve the player's floating-point policy.
  if(MSVC)
    target_compile_options(ps2_vu_probe PRIVATE /fp:strict)
  else()
    target_compile_options(ps2_vu_probe PRIVATE -ffp-contract=off)
  endif()
  add_executable(ps2_iop_probe tests/native_iop_probe.cpp)
  add_executable(ps2_scheduler_probe tests/native_scheduler_probe.cpp "${PS2_TEST_ROOT}/src/test_function_table.cpp")
  add_executable(ps2_gs_worker_probe tests/native_gs_worker_probe.cpp)
  add_executable(ps2_vif_gif_worker_probe tests/native_vif_gif_worker_probe.cpp
    "${PS2_TEST_ROOT}/src/test_function_table.cpp")
  target_link_libraries(ps2_gs_worker_probe PRIVATE ps2_runtime)
  target_link_libraries(ps2_vif_gif_worker_probe PRIVATE ps2_runtime)
  target_link_libraries(ps2_scheduler_probe PRIVATE ps2_runtime)
  if(NOT DECOMP_PS2_REFERENCE)
    file(GLOB TEST_VU_OPERATIONS CONFIGURE_DEPENDS "${CMAKE_CURRENT_SOURCE_DIR}/tests/vu/*.cpp")
    file(GLOB TEST_IOP_OPERATIONS CONFIGURE_DEPENDS "${CMAKE_CURRENT_SOURCE_DIR}/tests/iop/*.cpp")
    file(GLOB TEST_VU_PROGRAMS CONFIGURE_DEPENDS "${CMAKE_CURRENT_SOURCE_DIR}/tests/vu_programs/*.cpp")
    target_sources(ps2_vu_probe PRIVATE ${TEST_VU_OPERATIONS})
    target_sources(ps2_vu_probe PRIVATE ${TEST_VU_PROGRAMS})
    set_source_files_properties(${TEST_VU_OPERATIONS} ${TEST_VU_PROGRAMS} PROPERTIES COMPILE_OPTIONS "${_decomp_ps2_vu_options}")
    target_sources(ps2_iop_probe PRIVATE ${TEST_IOP_OPERATIONS})
    target_compile_definitions(ps2_vu_probe PRIVATE DECOMP_PS2_NATIVE_VU=1)
    if(VU_NATIVE_PROGRAMS)
      target_compile_definitions(ps2_vu_probe PRIVATE DECOMP_PS2_NATIVE_VU_PROGRAMS=1)
    endif()
    target_compile_definitions(ps2_iop_probe PRIVATE DECOMP_PS2_NATIVE_IOP=1)
  endif()
  target_include_directories(ps2_vu_probe PRIVATE
    "${PORT_ROOT}/thirdparty/PS2Recomp/ps2xRuntime/src/lib/vu")
  target_include_directories(ps2_iop_probe PRIVATE
    "${CMAKE_CURRENT_SOURCE_DIR}/native/iop"
    "${PORT_ROOT}/thirdparty/PS2Recomp/ps2xIOP/src"
    "${PORT_ROOT}/thirdparty/PS2Recomp/ps2xIOP/src/lle")
  target_link_libraries(ps2_vu_probe PRIVATE ps2_runtime)
  target_link_libraries(ps2_iop_probe PRIVATE ps2_iop)
  foreach(target ps2_vu_probe ps2_iop_probe ps2_scheduler_probe ps2_gs_worker_probe ps2_vif_gif_worker_probe)
    if(MSVC)
      target_compile_options(${target} PRIVATE /bigobj)
      target_link_options(${target} PRIVATE /STACK:8388608)
      target_sources(${target} PRIVATE native/utf8.manifest)
    endif()
  endforeach()
  ps2x_stage_ffmpeg_runtime_dlls(ps2_vu_probe)
  ps2x_stage_ffmpeg_runtime_dlls(ps2_scheduler_probe)
  ps2x_stage_ffmpeg_runtime_dlls(ps2_vif_gif_worker_probe)
endif()
