function(decomp_ps2_native_audio_clock)
  if(NOT TARGET raylib OR NOT TARGET ps2_runtime)
    return()
  endif()
  if(DEFINED SUPPORT_MODULE_RAUDIO AND NOT SUPPORT_MODULE_RAUDIO)
    return()
  endif()
  get_target_property(raylib_type raylib TYPE)
  if(NOT raylib_type STREQUAL "STATIC_LIBRARY")
    return()
  endif()
  get_target_property(raylib_source_dir raylib SOURCE_DIR)
  set(source "${raylib_source_dir}/raudio.c")
  if(NOT EXISTS "${source}")
    return()
  endif()
  file(SHA256 "${source}" digest)
  if(NOT digest STREQUAL "fbf272ddcad4b34a59382d302f4b59d5cb3e1deee069edd742596b112c54478a")
    return()
  endif()
  get_target_property(sources raylib SOURCES)
  list(LENGTH sources before)
  list(FILTER sources EXCLUDE REGEX "(^|/)raudio\\.c$")
  list(LENGTH sources after)
  math(EXPR expected "${before} - 1")
  if(NOT after EQUAL expected)
    return()
  endif()

  # Keep the content-addressed FetchContent source tree intact.
  set(adapter "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/audio_clock.inl")
  set(wrapper "${CMAKE_CURRENT_BINARY_DIR}/decomp_raudio.c")
  file(CONFIGURE OUTPUT "${wrapper}" CONTENT "#include \"@source@\"\n#include \"@adapter@\"\n" @ONLY)
  set_property(TARGET raylib PROPERTY SOURCES "${sources}")
  target_sources(raylib PRIVATE "${wrapper}")
  target_compile_definitions(ps2_runtime PRIVATE DECOMP_PS2_NATIVE_AUDIO_CLOCK=1)
endfunction()

decomp_ps2_native_audio_clock()
