cmake_minimum_required(VERSION 3.20)
project(GbaNativeProbe VERSION 0.1.0 LANGUAGES C CXX)
set(GBA_DEFAULT_RENDERER "auto")
set(CMAKE_C_STANDARD 11)
set(CMAKE_CXX_STANDARD 20)
set(CMAKE_CXX_STANDARD_REQUIRED ON)
if(MSVC)
  add_compile_options(/utf-8 $<$<COMPILE_LANGUAGE:CXX>:/Zc:__cplusplus>)
  add_compile_definitions(_CRT_SECURE_NO_WARNINGS NOMINMAX WIN32_LEAN_AND_MEAN)
endif()
set(SDK "${CMAKE_CURRENT_SOURCE_DIR}/runtime/anygba")
include(FetchContent)
FetchContent_Declare(tomlplusplus
  URL https://raw.githubusercontent.com/marzer/tomlplusplus/v3.4.0/toml.hpp
  URL_HASH SHA256=6b5172ad4dd6519aec67b919181fa7a38a2234131e5b2afa232dfe444819783e
  DOWNLOAD_NO_EXTRACT TRUE)
FetchContent_MakeAvailable(tomlplusplus)
file(GLOB CORE CONFIGURE_DEPENDS "${SDK}/runtime/src/*.cpp")
file(GLOB CHEATS CONFIGURE_DEPENDS "${SDK}/runtime/src/cheats/*.cpp")
file(GLOB HARDWARE CONFIGURE_DEPENDS
  "${SDK}/runtime/src/apu/*.cpp" "${SDK}/runtime/src/ppu/*.cpp"
  "${SDK}/runtime/src/bios/*.cpp" "${SDK}/runtime/src/save/*.cpp"
  "${SDK}/runtime/src/state/*.cpp")
list(REMOVE_ITEM CORE "${SDK}/runtime/src/dispatch.cpp")
add_library(gba_runtime_core OBJECT ${CORE} ${HARDWARE} ${CHEATS}
  "${SDK}/common/src/sha256.cpp" "${SDK}/common/src/crc32.cpp")
add_library(gba_runtime STATIC $<TARGET_OBJECTS:gba_runtime_core> "${SDK}/runtime/src/dispatch.cpp")
option(GBA_BUILD_REFERENCE "Build the explicit interpreter/reference probe" ON)
set(GBA_RUNTIME_TARGETS gba_runtime_core gba_runtime)
if(GBA_BUILD_REFERENCE)
  file(GLOB REFERENCE CONFIGURE_DEPENDS "${SDK}/runtime/src/interp/*.cpp" "${SDK}/tools/recomp/decode/*.cpp")
  add_library(gba_reference_runtime STATIC $<TARGET_OBJECTS:gba_runtime_core>
    "${SDK}/runtime/src/dispatch.cpp" ${REFERENCE})
  target_compile_definitions(gba_reference_runtime PRIVATE ANYGBA_ENABLE_REFERENCE=1)
  list(APPEND GBA_RUNTIME_TARGETS gba_reference_runtime)
endif()
foreach(target IN LISTS GBA_RUNTIME_TARGETS)
  target_include_directories(${target} PUBLIC "${SDK}/runtime/include" "${SDK}/common/include"
    PRIVATE "${SDK}/runtime/src" "${SDK}/tools/recomp" native)
  target_compile_definitions(${target} PRIVATE ANYGBA_VERSION="decomp.wtf-native")
endforeach()
target_include_directories(gba_runtime_core SYSTEM PRIVATE "${tomlplusplus_SOURCE_DIR}")
file(GLOB GAME CONFIGURE_DEPENDS "game/*.c")
add_library(gba_game STATIC ${GAME})
target_include_directories(gba_game PUBLIC game "${SDK}/runtime/include" "${SDK}/common/include")
set(GBA_PLAYERS gba_pc)
if(GBA_BUILD_REFERENCE)
  add_executable(gba_probe native/main.cpp)
  target_link_libraries(gba_probe PRIVATE gba_game gba_reference_runtime)
  list(APPEND GBA_PLAYERS gba_probe)
endif()
add_executable(gba_pc EXCLUDE_FROM_ALL native/main.cpp)
target_link_libraries(gba_pc PRIVATE gba_game gba_runtime)
target_compile_definitions(gba_pc PRIVATE GBA_GAME_DEFAULT=1 GBA_NATIVE_ONLY=1)
target_compile_definitions(gba_pc PRIVATE GBA_DEFAULT_RENDERER="${GBA_DEFAULT_RENDERER}")
foreach(target IN LISTS GBA_PLAYERS)
  target_include_directories(${target} PRIVATE "${SDK}/runtime/src" native)
  target_sources(${target} PRIVATE native/cheats.cpp)
  if(EXISTS "${CMAKE_CURRENT_SOURCE_DIR}/custom/game.cpp")
    target_sources(${target} PRIVATE custom/game.cpp)
    target_compile_definitions(${target} PRIVATE GBA_CUSTOMIZED=1)
  else()
    target_sources(${target} PRIVATE native/customization.cpp)
    target_compile_definitions(${target} PRIVATE GBA_CUSTOMIZED=0)
  endif()
endforeach()
option(GBA_WITH_DESKTOP "Build SDL desktop, audio/input and raw-state OpenGL rendering" OFF)
option(GBA_BUILD_GPU_TESTS "Build the original raw-state GPU conformance scenes" OFF)
if(GBA_WITH_DESKTOP)
  find_package(SDL3 3.4 CONFIG QUIET)
  if(NOT SDL3_FOUND)
    include(FetchContent)
    set(SDL_TEST_LIBRARY OFF CACHE BOOL "" FORCE)
    set(SDL_TESTS OFF CACHE BOOL "" FORCE)
    set(SDL_SHARED OFF CACHE BOOL "" FORCE)
    set(SDL_STATIC ON CACHE BOOL "" FORCE)
    if(POLICY CMP0135)
      cmake_policy(SET CMP0135 NEW)
    endif()
    FetchContent_Declare(SDL3
      URL https://github.com/libsdl-org/SDL/releases/download/release-3.4.10/SDL3-3.4.10.tar.gz
      URL_HASH SHA256=12b34280415ec8418c864408b93d008a20a6530687ee613d60bfbd20411f2785)
    FetchContent_MakeAvailable(SDL3)
  endif()
  file(READ "${CMAKE_CURRENT_SOURCE_DIR}/native/ppu.frag" GBA_PPU_SOURCE)
  configure_file(native/shader.hpp.in ppu_shader.hpp @ONLY)
  add_library(gba_video STATIC native/video.cpp)
  target_include_directories(gba_video PUBLIC native "${SDK}/runtime/include" "${SDK}/common/include"
    PRIVATE "${CMAKE_CURRENT_BINARY_DIR}")
  target_link_libraries(gba_video PUBLIC SDL3::SDL3)
  foreach(target IN LISTS GBA_PLAYERS)
    target_compile_definitions(${target} PRIVATE GBA_WITH_DESKTOP=1)
    target_link_libraries(${target} PRIVATE gba_video)
    if(WIN32)
      target_sources(${target} PRIVATE native/settings_win32.cpp)
      target_link_libraries(${target} PRIVATE user32 gdi32 shell32)
    endif()
  endforeach()
  if(GBA_BUILD_GPU_TESTS)
    add_executable(gba_gpu_tests tests/graphics.cpp)
    target_link_libraries(gba_gpu_tests PRIVATE gba_video gba_runtime)
  endif()
endif()
include(CTest)
if(GBA_BUILD_REFERENCE)
  add_test(NAME usage COMMAND gba_probe --help)
else()
  add_test(NAME usage COMMAND gba_pc --help)
endif()
if(BUILD_TESTING)
  add_executable(gba_frame_input_tests tests/frame_input.cpp)
  target_include_directories(gba_frame_input_tests PRIVATE native)
  add_test(NAME frame_input COMMAND gba_frame_input_tests)
  if(EXISTS "${CMAKE_CURRENT_SOURCE_DIR}/custom/tests.cpp")
    add_executable(gba_custom_tests custom/tests.cpp custom/game.cpp)
    target_include_directories(gba_custom_tests PRIVATE native "${SDK}/runtime/src")
    target_link_libraries(gba_custom_tests PRIVATE gba_runtime)
    add_test(NAME custom_game COMMAND gba_custom_tests "${CMAKE_CURRENT_SOURCE_DIR}/assets/game.gba")
  endif()
  add_executable(gba_cheat_tests tests/cheats.cpp native/cheats.cpp)
  target_include_directories(gba_cheat_tests PRIVATE "${SDK}/runtime/src" native)
  target_link_libraries(gba_cheat_tests PRIVATE gba_runtime)
  add_test(NAME cheats COMMAND gba_cheat_tests "${CMAKE_CURRENT_BINARY_DIR}/cheat-test-data")
  add_executable(gba_cartridge_tests tests/cartridge.cpp)
  target_include_directories(gba_cartridge_tests PRIVATE "${SDK}/runtime/src" native)
  target_link_libraries(gba_cartridge_tests PRIVATE gba_runtime)
endif()
