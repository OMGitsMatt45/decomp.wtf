cmake_minimum_required(VERSION 3.20)
project(CTRSourceProbe LANGUAGES C CXX)
set(CMAKE_C_STANDARD 11)
set(CMAKE_CXX_STANDARD 20)
file(GLOB GAME_SOURCE CONFIGURE_DEPENDS "${CMAKE_CURRENT_SOURCE_DIR}/game/*.c")
add_executable(ctr_probe runtime/probe.cpp ${GAME_SOURCE})
target_include_directories(ctr_probe PRIVATE game runtime)
if(MSVC)
  target_compile_options(ctr_probe PRIVATE /fp:strict)
else()
  target_compile_options(ctr_probe PRIVATE -fno-strict-aliasing)
  target_link_libraries(ctr_probe PRIVATE m)
endif()
