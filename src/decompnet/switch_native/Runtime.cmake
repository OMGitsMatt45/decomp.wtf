cmake_minimum_required(VERSION 3.20)
project(SwitchModuleRuntime LANGUAGES C CXX)
if(NOT CMAKE_C_COMPILER_ID MATCHES "Clang")
  message(FATAL_ERROR "Switch generated C needs Clang (GNU C, __int128 and musttail).")
endif()
set(CMAKE_C_STANDARD 11)
set(CMAKE_CXX_STANDARD 20)
file(GLOB GAME_SOURCE CONFIGURE_DEPENDS "${CMAKE_CURRENT_SOURCE_DIR}/game/*.c")
add_executable(switch_runtime runtime/runtime.c runtime/kernel.c runtime/modules.c runtime/integrity.cpp ${GAME_SOURCE})
target_include_directories(switch_runtime PRIVATE game runtime)
target_compile_options(switch_runtime PRIVATE $<$<COMPILE_LANGUAGE:C>:-fno-strict-aliasing;-ffp-contract=off>)
if(CMAKE_SYSTEM_PROCESSOR MATCHES "^(x86_64|AMD64|amd64)$")
  target_compile_options(switch_runtime PRIVATE $<$<COMPILE_LANGUAGE:C>:-mcx16>)
endif()
if(NOT WIN32)
  target_link_libraries(switch_runtime PRIVATE m)
endif()
